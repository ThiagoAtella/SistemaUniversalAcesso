<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="#1E1E1E"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iconCredencial"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_qr"/> <TextView
        android:id="@+id/textViewTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:text="QR Code"
        android:textColor="#00D4FF"
        android:textSize="20sp"
        android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#3300D4FF"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Geral"
            android:textColor="#00D4FF" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewExpira"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Expira em: 25/09/2025 11:00"
        android:textColor="#A0A0A0" />

    <Button
        android:id="@+id/btnVisualizar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Visualizar QR Code"
        android:visibility="gone" /> </LinearLayout>
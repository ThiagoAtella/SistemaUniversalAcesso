<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:background="#0F111F"
    android:padding="24dp">

    <ImageView
        android:id="@+id/ivQRCode"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:src="@drawable/ic_qr_placeholder" />

    <TextView
        android:id="@+id/tvValidade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QR expira em: -- segundos"
        android:textColor="@color/azul_neon"
        android:layout_marginTop="16dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnGerarQRCode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerar QR Code"
        android:textStyle="bold"
        android:textColor="@color/azul_neon"
        android:backgroundTint="#0F111F"
        android:elevation="6dp"
        android:layout_marginTop="24dp" />
</LinearLayout>
